\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Group-conditional empirical coverage on a two-group heteroscedastic regression task, target 0.90. Training set 1200 points, test set 400 points, conditional standard deviation 3 for the high-noise group and 0.75 for the low-noise group. Dashed line marks target coverage. Split conformal (orange) achieves marginal coverage by under-covering the high-noise group. Mondrian (blue) computes calibration quantiles per group and delivers the target within each subgroup.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:mond}{{4}{6}{Group-conditional empirical coverage on a two-group heteroscedastic regression task, target 0.90. Training set 1200 points, test set 400 points, conditional standard deviation 3 for the high-noise group and 0.75 for the low-noise group. Dashed line marks target coverage. Split conformal (orange) achieves marginal coverage by under-covering the high-noise group. Mondrian (blue) computes calibration quantiles per group and delivers the target within each subgroup}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.6.2}Weighted conformal for covariate shift}{6}{subsection.2.6.2}\protected@file@percent }
