\citation{sadinle2019least}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mean APS prediction-set size grouped by predictive entropy decile, three-class synthetic task, target coverage 0.90. Training set of 600 observations with three classes separable up to an overlap region around the decision boundary; 300 test points scored by \texttt  {conformal\_aps()} wrapping a 200-tree \texttt  {ranger} classifier. Difficulty deciles are computed from the entropy of the classifier softmax output. Mean set size rises with entropy, from 1.00 in the lowest decile to 1.83 in the highest, against a mean of 1.36 overall and a maximum possible size of three.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:aps}{{3}{5}{Mean APS prediction-set size grouped by predictive entropy decile, three-class synthetic task, target coverage 0.90. Training set of 600 observations with three classes separable up to an overlap region around the decision boundary; 300 test points scored by \texttt {conformal\_aps()} wrapping a 200-tree \texttt {ranger} classifier. Difficulty deciles are computed from the entropy of the classifier softmax output. Mean set size rises with entropy, from 1.00 in the lowest decile to 1.83 in the highest, against a mean of 1.36 overall and a maximum possible size of three}{figure.caption.5}{}}
\@writefile{brf}{\backcite{angelopoulos2021uncertainty}{{5}{2.5}{figure.caption.5}}}
\@writefile{brf}{\backcite{sadinle2019least}{{5}{2.5}{figure.caption.5}}}
