\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Empirical per-race coverage from marginal APS and Mondrian APS on COMPAS two-year recidivism, target 0.90. Data: ProPublica COMPAS dataset (6167 defendants after standard ProPublica screening). Caucasian and African-American subgroups shown. Dashed line at 0.90 marks target coverage. Marginal APS realises 0.910 (Caucasian) and 0.917 (African-American); Mondrian APS, which computes a separate calibration quantile per group, realises 0.912 and 0.891. Both procedures track the target closely on this dataset, because the calibration distributions of the two groups are similar; Mondrian secures per-group coverage by construction rather than by that similarity.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:compas}{{6}{8}{Empirical per-race coverage from marginal APS and Mondrian APS on COMPAS two-year recidivism, target 0.90. Data: ProPublica COMPAS dataset (6167 defendants after standard ProPublica screening). Caucasian and African-American subgroups shown. Dashed line at 0.90 marks target coverage. Marginal APS realises 0.910 (Caucasian) and 0.917 (African-American); Mondrian APS, which computes a separate calibration quantile per group, realises 0.912 and 0.891. Both procedures track the target closely on this dataset, because the calibration distributions of the two groups are similar; Mondrian secures per-group coverage by construction rather than by that similarity}{figure.caption.8}{}}
